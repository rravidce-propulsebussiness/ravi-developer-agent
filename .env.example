# Never commit real credentials.
# Provider OAuth and encrypted per-user connection storage are added in the auth milestone.

# Cloudflare production and preview builds use a dedicated Ravi Developer Agent build token.

# Optional self-hosted browser backend.
# Configure both values on the Ravi Developer Agent Worker to prefer your own
# Chromium runner. Keep SELF_HOSTED_BROWSER_TOKEN secret.
SELF_HOSTED_BROWSER_URL=https://browser.example.com
SELF_HOSTED_BROWSER_TOKEN=replace-with-the-runner-token
