{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ravi-developer-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "browser": { "binding": "BROWSER" },
  "services": [{ "binding": "AUTH_SERVER", "service": "ravi-developer-agent-auth" }],
  "durable_objects": {
    "bindings": [{ "name": "BROWSER_SESSIONS", "class_name": "TenantBrowserSession" }]
  },
  "migrations": [{ "tag": "browser-sessions-v1", "new_sqlite_classes": ["TenantBrowserSession"] }]
}
