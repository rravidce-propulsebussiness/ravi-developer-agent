# Required: random secret, at least 32 characters.
RUNNER_TOKEN=replace-with-a-long-random-secret

# Bind locally by default. For a VPS behind a reverse proxy or Cloudflare Tunnel,
# set RUNNER_HOST=0.0.0.0 and keep the public endpoint HTTPS-only.
RUNNER_HOST=127.0.0.1
RUNNER_PORT=8788

# Public HTTPS origin used in short-lived read-only Live View URLs.
# Example: https://browser.example.com
PUBLIC_BASE_URL=https://browser.example.com

# Optional. Leave empty to use Playwright's installed Chromium.
CHROME_PATH=

# Headless is recommended on a VPS. Use false on a desktop if you also want
# to see the local Chrome window.
HEADLESS=true

# Maximum simultaneously active isolated browser contexts.
MAX_SESSIONS=8

# Close idle sessions automatically. 0 disables idle cleanup.
SESSION_IDLE_MS=1800000
