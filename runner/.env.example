# Required: random secret, at least 32 characters.
RUNNER_TOKEN=replace-with-a-long-random-secret

# Cloud/VPS runner. The container listens on all interfaces internally, while
# docker-compose publishes it only to host loopback for a reverse proxy/tunnel.
RUNNER_HOST=0.0.0.0
RUNNER_PORT=8788

# Public HTTPS origin used by short-lived read-only Live View URLs.
PUBLIC_BASE_URL=https://browser.example.com

# Leave empty to use Playwright's bundled Chromium.
CHROME_PATH=
HEADLESS=true

# Conservative defaults for a small ARM64 cloud VM. Increase only after
# observing memory/CPU usage.
MAX_SESSIONS=4
SESSION_IDLE_MS=1800000

# Persist authenticated browser state across container recreation.
BROWSER_PROFILE_DIR=/data/browser-profiles

# Existing manually-managed aliases remain supported. Do not commit values.
# BROWSER_SECRET_HOSTINGER_PASSWORD=
