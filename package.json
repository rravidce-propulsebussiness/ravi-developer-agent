{
  "name": "ravi-developer-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "deploy:auth": "wrangler deploy -c wrangler.auth.jsonc",
    "dev:auth": "wrangler dev -c wrangler.auth.jsonc",
    "test": "vitest run",
    "verify": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.26.0",
    "zod": "4.6.5",
    "@cloudflare/workers-oauth-provider": "1.2.2",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@cloudflare/puppeteer": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "typescript": "7.0.2",
    "wrangler": "4.147.0",
    "vitest": "5.0.3"
  }
}
